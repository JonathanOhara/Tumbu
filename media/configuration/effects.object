// Visual effects of the special attacks (EffectsManager, Effect, EffectLayers). Read when an effect starts, so a
// change shows on the next attack after a restart of the match.
//
// "effect <name>" holds one block per layer. Colours are "r g b" (values above 1 glow through the bloom) or
// "ki [factor]": the colour of the attack that started the effect (Jyn: Genki Dama blue-white; punch and kick: the
// robot's eye colour).
//
// light: a coloured point light on the robots and the arena (the four strongest at a time)
//     colour      light colour
//     intensity   multiplies the colour
//     radius      world units where it fades to nothing
//     rise        seconds to full strength
//     time        seconds to fade out after the rise; 0 = stays (times the effect's intensity) until the owner
//                 releases the effect, then fades over "fade" seconds
//     flicker     0..1, uneven crackle of the strength
//     offset      x y z from the effect position
//
// trail: a ribbon left behind as the effect moves (held effects that follow a ball)
//     colour      ribbon colour; width: world units at the ball; length: world units of ribbon kept
//     fadeTime    seconds each point takes to fade and narrow to nothing; segments: points kept (20)
//     material    Tumbu/EnergyTrail (default), Tumbu/EnergyTrail/Mote, Tumbu/EnergyTrail/Jyn (effects.material)
//
// particles: an Ogre particle system from a template (media/tumbu/effects/effects.particle)
//     template    the particle_system name; colour: replaces the emitters' colour
//     time        seconds of emission (a burst); 0 = until the effect is let go
//     follow      1 (default) = follows the effect; 0 = stays where it started
//
// screen: when the effect starts (once)
//     flash       0..1, how far the whole frame turns to flashColour; flashTime: seconds to fade
//     shake       camera shake amplitude in world units; shakeTime: seconds; shakeRange: full shake within this
//                 distance of the camera, none beyond twice it
//     hitStop     seconds the game nearly stops (the impact "hangs"), real time

// Calibration effect for DevTest -fxtest=test: a strong orange light, a flash and a shake.
effect test
{
	light
	{
		colour 1 0.55 0.2
		intensity 4
		radius 6
		rise 0.05
		time 3
	}
	screen
	{
		flash 0.6
		flashColour 1 1 1
		flashTime 0.15
		shake 0.12
		shakeTime 0.4
		hitStop 0.06
	}
}

// ---- Energy balls: held effects that follow the ball (SpecialInterface::startBallEffect) ----
// The light stays while the ball lives ("time 0", times the effect's intensity) and fades when it is let go.
// Moderate intensities keep the ki colour on the floor and robots; strong ones wash out to white.

// Punch ki blast.
effect punch_ball
{
	light
	{
		colour ki
		intensity 1.4
		radius 2.6
		rise 0.06
		time 0
		fade 0.15
		flicker 0.12
	}
	trail
	{
		colour ki
		width 0.4
		length 1.8
		fadeTime 0.25
	}
	particles
	{
		template Tumbu/Fx/Sparks
		colour ki
	}
}

// Kick ki blast.
effect kick_ball
{
	light
	{
		colour ki
		intensity 1.4
		radius 2.6
		rise 0.06
		time 0
		fade 0.15
		flicker 0.12
	}
	trail
	{
		colour ki
		width 0.4
		length 1.8
		fadeTime 0.25
	}
	particles
	{
		template Tumbu/Fx/Sparks
		colour ki
	}
}

// Jyn (Genki Dama): from the cast it lights the robot from above, growing as the swarm merges into the ball
// (intensity 0.3 -> 1), then lights the arena as it flies.
effect jyn_ball
{
	light
	{
		colour ki
		intensity 1.8
		radius 4.5
		rise 0.4
		time 0
		fade 0.3
		flicker 0.08
	}
}

// One stream of the swarm flying into the Genki Dama (one per swarm ball, let go when the ball merges).
effect jyn_mote
{
	trail
	{
		colour ki
		width 0.16
		length 1.6
		fadeTime 0.35
		material Tumbu/EnergyTrail/Mote
	}
}

// The thrown Genki Dama: a thick wake and big sparks (its light is jyn_ball's).
effect jyn_throw
{
	trail
	{
		colour ki
		width 0.55
		length 3.5
		fadeTime 0.4
		segments 30
		material Tumbu/EnergyTrail/Jyn
	}
	particles
	{
		template Tumbu/Fx/SparksBig
		colour ki
	}
}

// Calibration for DevTest -fxtest=trailtest: a punch-like trail and sparks (DevTest moves it in a circle).
effect trailtest
{
	trail
	{
		colour ki
		width 0.4
		length 1.8
		fadeTime 0.25
	}
	particles
	{
		template Tumbu/Fx/Sparks
		colour ki
	}
}