// Visual effects of the special attacks (EffectsManager, Effect, EffectLayers). Read when an effect starts, so a
// change shows on the next attack after a restart of the match.
//
// "effect <name>" holds one block per layer. Colours are "r g b" (values above 1 glow through the bloom) or
// "ki [factor]": the colour of the attack that started the effect (Jyn: Genki Dama blue-white; punch and kick: the
// robot's eye colour).
//
// light: a coloured point light on the robots and the arena (the four strongest at a time)
//     colour      light colour
//     intensity   multiplies the colour
//     radius      world units where it fades to nothing
//     rise        seconds to full strength
//     time        seconds to fade out after the rise; 0 = stays (times the effect's intensity) until the owner
//                 releases the effect, then fades over "fade" seconds
//     flicker     0..1, uneven crackle of the strength
//     offset      x y z from the effect position
//
// trail: a ribbon left behind as the effect moves (held effects that follow a ball)
//     colour      ribbon colour; width: world units at the ball; length: world units of ribbon kept
//     fadeTime    seconds each point takes to fade and narrow to nothing; segments: points kept (20)
//     material    Tumbu/EnergyTrail (default), Tumbu/EnergyTrail/Mote, Tumbu/EnergyTrail/Jyn (effects.material)
//
// particles: an Ogre particle system from a template (media/tumbu/effects/effects.particle)
//     template    the particle_system name; colour: replaces the emitters' colour
//     time        seconds of emission (a burst); 0 = until the effect is let go
//     follow      1 (default) = follows the effect; 0 = stays where it started
//     offset      x y z from the effect; ground: 1 = on the floor below the effect (physics ray)
//     (a one-shot effect emits for 0.2 s when "time" is not given)
//
// converge: motes pulled into the effect (a fixed pool that loops while the effect is held)
//     material / billboard  Tumbu/EnergySpark + oriented_self (default) or e.g. Tumbu/Fx/Smoke + point
//     count       motes; time: seconds of one trip; swirl: radians turned around the target on the way
//     from        sphere (default: around the target, at "height" min max) or ground (on the floor around it)
//     radius      min max start distance; size: width length; endRadius: stop distance (x the effect scale)
//     toGround    1 = the target is the floor below the effect (dust dragged to the feet)
//
// lightning: jagged arcs over a sphere around the effect, rebuilt every "interval" seconds
//     radius      x the effect scale (the ball radius); width; arcs; segments; chance: of each arc per rebuild;
//     leap        share of bolts jumping off the surface; material (Tumbu/EnergyTrail/Lightning)
//
// screen: when the effect starts (once)
//     flash       0..1, how far the whole frame turns to flashColour; flashTime: seconds to fade
//     shake       camera shake amplitude in world units; shakeTime: seconds; shakeRange: full shake within this
//                 distance of the camera, none beyond twice it
//     hitStop     seconds the game nearly stops (the impact "hangs"), real time

// Calibration effect for DevTest -fxtest=test: a strong orange light, a flash and a shake.
effect test
{
	light
	{
		colour 1 0.55 0.2
		intensity 4
		radius 6
		rise 0.05
		time 3
	}
	screen
	{
		flash 0.6
		flashColour 1 1 1
		flashTime 0.15
		shake 0.12
		shakeTime 0.4
		hitStop 0.06
	}
}

// ---- Energy balls: held effects that follow the ball (SpecialInterface::startBallEffect) ----
// The light stays while the ball lives ("time 0", times the effect's intensity) and fades when it is let go.
// Moderate intensities keep the ki colour on the floor and robots; strong ones wash out to white.

// Punch ki blast.
effect punch_ball
{
	light
	{
		colour ki
		intensity 1.4
		radius 2.6
		rise 0.06
		time 0
		fade 0.15
		flicker 0.12
	}
	trail
	{
		colour ki
		width 0.4
		length 1.8
		fadeTime 0.25
	}
	particles
	{
		template Tumbu/Fx/Sparks
		colour ki
	}
}

// Kick ki blast.
effect kick_ball
{
	light
	{
		colour ki
		intensity 1.4
		radius 2.6
		rise 0.06
		time 0
		fade 0.15
		flicker 0.12
	}
	trail
	{
		colour ki
		width 0.4
		length 1.8
		fadeTime 0.25
	}
	particles
	{
		template Tumbu/Fx/Sparks
		colour ki
	}
}

// Jyn (Genki Dama): from the cast it lights the robot from above, growing as the swarm merges into the ball
// (intensity 0.3 -> 1), then lights the arena as it flies.
effect jyn_ball
{
	light
	{
		colour ki
		intensity 1.8
		radius 4.5
		rise 0.4
		time 0
		fade 0.3
		flicker 0.08
	}
}

// One stream of the swarm flying into the Genki Dama (one per swarm ball, let go when the ball merges).
effect jyn_mote
{
	trail
	{
		colour ki
		width 0.16
		length 1.6
		fadeTime 0.35
		material Tumbu/EnergyTrail/Mote
	}
}

// The thrown Genki Dama: a thick wake and big sparks (its light is jyn_ball's).
effect jyn_throw
{
	trail
	{
		colour ki
		width 0.55
		length 3.5
		fadeTime 0.4
		segments 30
		material Tumbu/EnergyTrail/Jyn
	}
	particles
	{
		template Tumbu/Fx/SparksBig
		colour ki
	}
}

// Calibration for DevTest -fxtest=trailtest: a punch-like trail and sparks (DevTest moves it in a circle).
effect trailtest
{
	trail
	{
		colour ki
		width 0.4
		length 1.8
		fadeTime 0.25
	}
	particles
	{
		template Tumbu/Fx/Sparks
		colour ki
	}
}
// ---- Impacts: one-shot effects at the hit point (the ball's colour) ----

// Punch or kick blast hits a robot: star flash, shockwave, spark burst, a flash of light, a small jolt.
effect blast_hit
{
	particles
	{
		template Tumbu/Fx/HitFlash
		colour ki
		follow 0
	}
	particles
	{
		template Tumbu/Fx/HitRing
		colour ki
		follow 0
	}
	particles
	{
		template Tumbu/Fx/HitSparks
		colour ki
		follow 0
	}
	light
	{
		colour ki
		intensity 2
		radius 3.5
		rise 0
		time 0.3
	}
	screen
	{
		shake 0.05
		shakeTime 0.2
		shakeRange 5
	}
}

// Punch or kick blast hits the arena: a smaller flash and sparks.
effect blast_wall
{
	particles
	{
		template Tumbu/Fx/HitFlash
		colour ki
		follow 0
	}
	particles
	{
		template Tumbu/Fx/HitSparks
		colour ki
		follow 0
	}
	light
	{
		colour ki
		intensity 2
		radius 2.5
		rise 0
		time 0.2
	}
}

// Genki Dama impact: white frame, hit-stop, a toon explosion ball, a shockwave along the ground, sparks, debris and
// smoke, a strong light and a camera shake.
effect jyn_impact
{
	screen
	{
		flash 0.45
		flashColour 1 1 1
		flashTime 0.12
		shake 0.16
		shakeTime 0.5
		shakeRange 10
		hitStop 0.07
	}
	particles
	{
		template Tumbu/Fx/HitFlash
		colour ki
		follow 0
	}
	particles
	{
		template Tumbu/Fx/Dome
		colour ki
		follow 0
	}
	particles
	{
		template Tumbu/Fx/GroundRing
		colour ki
		follow 0
		ground 1
	}
	particles
	{
		template Tumbu/Fx/HitSparks
		colour ki
		follow 0
	}
	particles
	{
		template Tumbu/Fx/Debris
		follow 0
		ground 1
	}
	particles
	{
		template Tumbu/Fx/Smoke
		follow 0
		ground 1
		offset 0 0.3 0
	}
	light
	{
		colour ki
		intensity 2.5
		radius 5
		rise 0
		time 0.7
	}
}

// ---- Genki Dama gathering (held from the cast until the throw; SpecialJyn sets its strength and scale) ----
// Energy flies in from the air and rises from the ground into the ball, dust is dragged over the floor towards the
// robot's feet, and lightning crackles over the ball as it grows.
effect jyn_charge
{
	converge
	{
		colour ki
		count 36
		from sphere
		radius 2.5 5
		height -1.5 2
		time 1.1
		swirl 1.2
		size 0.04 0.35
		endRadius 0.8
	}
	converge
	{
		colour ki
		count 24
		from ground
		radius 1 3.5
		height 0 0.3
		time 1.5
		swirl 0.6
		size 0.035 0.3
		endRadius 0.8
	}
	converge
	{
		material Tumbu/Fx/Dust
		billboard point
		colour 0.92 0.86 0.78
		count 14
		from ground
		toGround 1
		radius 1.2 3
		height 0.05 0.15
		time 1.6
		swirl 0.8
		size 0.5 0.5
		endRadius 0.5
	}
	lightning
	{
		colour ki
		radius 1.15
		width 0.035
		arcs 4
		segments 8
		interval 0.07
		chance 0.55
		leap 0.35
	}
}
