// Lighting rig of the arena (Lighting.cpp). The look is a soft anime style: the sun goes through a toon ramp,
// the side away from the sun takes the shadow colour instead of going grey or black, the ambient light blends
// from a ground colour (below) to a sky colour (above), and a rim light outlines the robots against the sky.
//
// Colours are in display (gamma) space. The scene is rendered in HDR and the final pass compresses values
// above 1 (see exposure), so a lit surface may add up to a bit more than 1.
//
// "lighting configuration" holds the values that do not change with the time of day. The keyframes list the
// "lighting <name>" blocks in time order; the game clock blends the two keyframes around the current hour
// (and wraps from the last one back to the first).

lighting configuration{
	keyframes night dawn morning afternoon sunset twilight dusk

	// Toon ramp, applied to N.L remapped to 0..1: where the lit side starts, and how soft the edge is.
	rampThreshold 0.5
	rampSoftness 0.06
	// Rim light width (higher = thinner) and the soft edge of the stylised specular highlight.
	rimPower 3.5
	specularSoftness 0.05

	// Shadow map: depth bias, normal offset (world units the lookup moves out along the surface normal) and the
	// width of the soft edge in shadow-map texels. Stripes on lit surfaces: raise shadowNormalOffset (or the bias).
	// Light leaking where a wall meets the ground: lower shadowBias.
	shadowBias 0.0003
	shadowNormalOffset 0.04
	shadowSoftness 1.5

	// Bloom: glow around what is brighter than the threshold in the HDR image (eyes, energy balls, hot
	// highlights). A lit wall reaches about 1.1, so keep the threshold above that. Soft knee = how gradually the
	// glow fades in; strength = how much of it is added. The glow is a mip chain (half size to 1/64, all six levels
	// weighted equally): a tight hot core with a wide soft falloff.
	bloomThreshold 1.3
	bloomSoftKnee 0.4
	bloomStrength 0.85

	// Baked ambient occlusion (scripts/bake-arena-ao.ps1, robot AO maps): how much it darkens the ambient light and
	// the sun (0..1), and how much occluded areas lean towards the shadow colour instead of grey.
	aoAmbient 0.8
	aoDirect 0.3
	aoTint 0.5

	// Final image: saturation and contrast (1 = unchanged), and how much the corners darken.
	saturation 1.15
	contrast 1.05
	vignette 0.3

	// Hours when the light plays the moon (the visible sky puts the moon in its direction; otherwise the sun).
	// The twilight keyframe brings the sun down to the horizon first, so the switch is not seen.
	moonFrom 19.6
	moonUntil 5.5

	// God rays (volumetric sunlight through the shadow map): strength per unit of lit air, longest march in units,
	// forward scattering (0 = same from every angle, 0.9 = only looking at the sun) and samples per pixel (4..32).
	// A keyframe can scale the strength with its own shaftStrength (1 when missing).
	shaftStrength 0.0065
	shaftDistance 30
	shaftAnisotropy 0.5
	shaftSteps 32

	// Lens flare when looking towards the sun (glow, horizontal streak and ghosts; hidden by walls). 0 = off.
	lensFlare 0.7

	// Contact shadows: soft dark disc on the floor under each robot (fades when it jumps). Strength 0..1, radius.
	contactShadow 0.6
	contactShadowRadius 0.55

	// Distance fog: far geometry (mountains, terrain) fades into the sky colour. Start distance, density per unit,
	// maximum amount (0 = no fog), and the brightness of the fog colour (the sky's horizon band, skyHorizon x this).
	fogStart 35
	fogDensity 0.012
	fogMax 0.65
	fogBrightness 0.9

	// Dust motes (dust.particle): brightness in sunlight (scaled by the keyframe shaftStrength) and in shadow.
	// dustSunlight 0 hides them.
	dustSunlight 4.0
	dustShadow 0.02
	// Arena neon (the ring ropes and the T's tube in the centre): brightness of the glowing core in the HDR image
	// (above bloomThreshold, so it blooms). How much it glows is the keyframe value neon (0..1, 0 when missing).
	neonStrength 4.0
	// Night lights (the wall torches of art/arena/Arena.blend; positions in lamps.object, made by arena_shapes.py): the
	// torches' light colour and strength, how far it reaches (world units), the toon bands of the light pools, the light
	// on surfaces facing away (0..1), how much the flames flicker (0 = steady) and the flames' brightness in the HDR
	// image (above bloomThreshold: they glow). How much the torches burn is the keyframe value lamps (0..1, 0 when
	// missing: out by day).
	lampColour 1.0 0.58 0.26
	lampStrength 1.5
	lampReach 6
	lampBands 4
	lampBack 0.25
	lampFlicker 0.15
	flameBrightness 2.2
	// The red neon's light on the ring's tiles and the robots near the ropes and the T: colour, strength (0 = off),
	// reach (world units) and toon bands (fewer than lampBands: no rings around the ends of the T). It follows the
	// keyframe value neon.
	neonLightColour 1.0 0.06 0.04
	neonLight 2.0
	neonLightReach 2.0
	neonLightBands 2
	// The painted toon sky (sky.frag): brightness of the sun disc in the HDR image (above bloomThreshold: it glows).
	// The sky's colours are keyframe values (skyZenith, skyMid, skyHorizon: the bands; cloudLit, cloudShade and
	// cloudCover 0..1: the clouds; stars 0..1, 0 when missing).
	sunDiscBrightness 1.8

	// Screen-space AO: contact darkening between moving things (robots and floor, robots and walls). Radius in
	// world units and strength (0 = off).
	ssaoRadius 0.6
	ssaoStrength 1.2

	// Robot "hero lighting" (robots only; the arena is not affected): a soft fill light that follows the camera, so a
	// robot keeps a lit side and a shadow side in the coliseum's shadow, at dusk and at night. Its direction is
	// heroFillYaw degrees to the camera's right and heroFillPitch degrees above it (not straight from the camera,
	// which would look flat). It goes through the same toon ramp as the sun and is not shadowed. Colour and
	// strength are per keyframe (heroFillColour, heroFillStrength). heroFillSunlit: how much of it is left where
	// the sun already lights the surface (low = it barely changes a robot in sunlight). heroRimShadow: rim light on
	// the side the sun misses, relative to the lit side (the arena keeps 0.35).
	heroFillYaw 40
	heroFillPitch 35
	heroFillSunlit 0.25
	heroRimShadow 0.8

	// Robot metal (robots only; how much each part reflects is $metal in robotNNN.material). The armour reflects a
	// toon "environment" in flat bands, coloured by the current keyframe: sky above, a bright band, a dark horizon line,
	// ground below. metalBands: brightness of the sky, the bright band, the horizon line and the ground (x their
	// keyframe colours). metalBandHeights: where the bright band starts, where the horizon line starts and ends (the
	// height of the reflected direction, -1..1). metalStreak: strength of the sharp sun streak stretched along the
	// parts (replaces the round highlight). metalGlint: strength and size (cosine) of the sun's glint in the reflection.
	// metalFresnel: reflection facing the camera, relative to grazing angles. metalDiffuse: how much the reflection
	// replaces the painted colour (0 = only adds).
	metalBands 0.95 1.3 0.4 1.0
	metalBandHeights 0.24 0.04 -0.08
	metalStreak 0.75
	metalGlint 1.2 0.965
	metalFresnel 0.55
	metalDiffuse 0.3
}

// Each keyframe: the hour it applies to; sun elevation and azimuth in degrees (azimuth 0 = +Z, 90 = +X); the
// sun (or moon) colour; sky and ground ambient; the shadow colour (multiplies the sun on the side away from
// it); rim colour and strength; exposure of the final image; the colour and strength of the robots' fill light
// (heroFillColour, heroFillStrength: see heroFillYaw); optionally outlineTint, which multiplies the colour of the robots'
// outlines (white when missing), so the ink lines follow the light: cool and darker at night, warm at sunset.

// neon (optional, 0 when missing): how much the arena's neon glows (ring ropes, the T's tube): on at night.
// lamps (optional, 0 when missing): how much the wall torches burn (their flames and light): on at night.
lighting night{
	hour 1
	sunElevation 50
	sunAzimuth 250
	sunColour 0.24 0.30 0.50
	skyColour 0.12 0.15 0.27
	groundColour 0.06 0.06 0.10
	shadowColour 0.30 0.34 0.60
	rimColour 0.45 0.55 1.00
	rimStrength 0.45
	exposure 1.27
	heroFillColour 0.55 0.65 1.00
	heroFillStrength 0.55
	outlineTint 0.50 0.58 0.90
	shaftStrength 0.15
	neon 1
	lamps 1
	skyZenith 0.02 0.04 0.12
	skyMid 0.05 0.08 0.21
	skyHorizon 0.12 0.15 0.32
	cloudLit 0.28 0.31 0.50
	cloudShade 0.12 0.13 0.28
	cloudCover 0.30
	stars 1.00
}

lighting dawn{
	hour 6
	sunElevation 10
	sunAzimuth 60
	sunColour 1.00 0.68 0.48
	skyColour 0.36 0.38 0.54
	groundColour 0.22 0.17 0.16
	shadowColour 0.36 0.38 0.68
	rimColour 1.00 0.75 0.60
	rimStrength 0.45
	exposure 0.97
	heroFillColour 0.85 0.78 0.90
	heroFillStrength 0.35
	outlineTint 0.95 0.78 0.70
	shaftStrength 1.2
	neon 0.3
	lamps 0.15
	skyZenith 0.16 0.26 0.58
	skyMid 0.52 0.42 0.62
	skyHorizon 0.88 0.58 0.40
	cloudLit 0.95 0.78 0.66
	cloudShade 0.50 0.40 0.58
	cloudCover 0.40
	stars 0.15
}

lighting morning{
	hour 9
	sunElevation 28
	sunAzimuth 75
	sunColour 1.00 0.88 0.70
	skyColour 0.32 0.42 0.62
	groundColour 0.25 0.22 0.18
	shadowColour 0.42 0.50 0.78
	rimColour 0.80 0.90 1.00
	rimStrength 0.35
	exposure 0.92
	heroFillColour 0.85 0.90 1.00
	heroFillStrength 0.3
	skyZenith 0.10 0.34 0.80
	skyMid 0.26 0.52 0.90
	skyHorizon 0.62 0.72 0.82
	cloudLit 0.95 0.94 0.90
	cloudShade 0.60 0.66 0.84
	cloudCover 0.45
}

lighting afternoon{
	hour 15
	sunElevation 30
	sunAzimuth 120
	sunColour 1.00 0.88 0.70
	skyColour 0.32 0.42 0.62
	groundColour 0.25 0.22 0.18
	shadowColour 0.42 0.50 0.78
	rimColour 0.85 0.90 1.00
	rimStrength 0.35
	exposure 0.92
	heroFillColour 0.85 0.90 1.00
	heroFillStrength 0.3
	skyZenith 0.08 0.32 0.80
	skyMid 0.22 0.50 0.90
	skyHorizon 0.56 0.74 0.92
	cloudLit 0.95 0.96 0.98
	cloudShade 0.58 0.66 0.86
	cloudCover 0.45
}

lighting sunset{
	hour 18.5
	sunElevation 9
	sunAzimuth 140
	sunColour 1.00 0.64 0.40
	skyColour 0.34 0.36 0.52
	groundColour 0.21 0.17 0.16
	shadowColour 0.38 0.42 0.72
	rimColour 1.00 0.60 0.40
	rimStrength 0.5
	exposure 0.97
	heroFillColour 1.00 0.80 0.75
	heroFillStrength 0.45
	outlineTint 1.00 0.72 0.55
	shaftStrength 2.0
	neon 0.35
	lamps 0.35
	skyZenith 0.12 0.26 0.66
	skyMid 0.44 0.42 0.72
	skyHorizon 0.90 0.60 0.38
	cloudLit 0.96 0.80 0.62
	cloudShade 0.52 0.44 0.68
	cloudCover 0.45
}

lighting twilight{
	hour 19.5
	sunElevation 1
	sunAzimuth 145
	sunColour 0.70 0.42 0.38
	skyColour 0.30 0.28 0.45
	groundColour 0.16 0.12 0.14
	shadowColour 0.36 0.36 0.66
	rimColour 0.90 0.55 0.50
	rimStrength 0.5
	exposure 1.05
	heroFillColour 0.85 0.72 0.92
	heroFillStrength 0.6
	outlineTint 0.80 0.62 0.75
	shaftStrength 1.2
	neon 1
	lamps 1
	skyZenith 0.12 0.12 0.38
	skyMid 0.48 0.30 0.52
	skyHorizon 0.86 0.50 0.30
	cloudLit 0.92 0.66 0.50
	cloudShade 0.40 0.30 0.52
	cloudCover 0.40
	stars 0.20
}

lighting dusk{
	hour 20.5
	sunElevation 30
	sunAzimuth 200
	sunColour 0.34 0.34 0.53
	skyColour 0.19 0.19 0.34
	groundColour 0.09 0.085 0.13
	shadowColour 0.32 0.32 0.60
	rimColour 0.60 0.55 1.00
	rimStrength 0.45
	exposure 1.17
	heroFillColour 0.65 0.65 1.00
	heroFillStrength 0.55
	outlineTint 0.55 0.58 0.90
	shaftStrength 0.25
	neon 1
	lamps 1
	skyZenith 0.04 0.06 0.20
	skyMid 0.12 0.12 0.32
	skyHorizon 0.30 0.22 0.42
	cloudLit 0.44 0.40 0.60
	cloudShade 0.16 0.15 0.32
	cloudCover 0.30
	stars 0.70
}
