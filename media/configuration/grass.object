// The field's tall grass (Grass.cpp): toon blades generated when a match loads, where the field map's B channel says
// (media/tumbu/arena/field_map.png, painted in Blender: B = height x fullHeight; arena_field.py). Read at match start,
// so a restart is enough to try other values. The wind and the push (robots, energy balls) and the colours are in the
// material (Tumbu/FieldGrass, media/tumbu/arena/field_grass.material).
grass field{
	material Tumbu/FieldGrass
	// blades tried per square metre (fewer grow: not on the earth, the snow or under the ring and the walls)
	density 40
	// metres: a blade where the map's B is 1, before the clump, patch and per-blade variation (x 0.4 .. 1.9)
	fullHeight 0.9
	// no blade shorter than this (metres)
	minHeight 0.06
	// blade width at the root (metres): width + widthJitter x random, x (0.7 + 0.6 sqrt(height)) x widthScale
	// (the toon blades of the mock-ups: 2.2x the thin "dense blades")
	width 0.028
	widthJitter 0.02
	widthScale 2.2
	// how far the tip curves over, x its height: bend + bendJitter x random
	bend 0.25
	bendJitter 0.45
	// metres: blades in one clump cell share height, lean and tone; the height also varies over patches this big
	clumpSize 0.9
	patchSize 23
	// no blades this far inside the field shader's earth edge (field map R, threshold fieldParams.x), + random jitter
	earthMargin 0.08
	earthJitter 0.1
	// segments per blade (2 vertices each, plus the tip)
	segments 3
	// metres: the blades are drawn in square chunks this big (each culled on its own)
	chunkSize 8
	// units covered by the field map (the field's size, arena_field.py)
	mapExtent 196
	seed 1234
}

// The flowers among the tall grass (Grass.cpp): small models made in Blender (art/arena/Flowers.blend; exported to
// media/tumbu/arena/<mesh>.mesh by scripts/arena-flowers.ps1), planted in clumps of one kind each, where the tall grass
// grows (the same ground rules as the blades). They sway and part with the grass; their stiffness and shading are in
// media/tumbu/arena/field_flower.material.
flowers field{
	material Tumbu/FieldFlower
	// the kinds; the clumps take them in turn
	meshes flower_daisy flower_poppy flower_lupine flower_forgetmenot flower_marigold
	// clumps spread around the ring, between these distances from the centre (units)
	clumps 10
	ringFrom 14.5
	ringTo 18
	// flowers per clump (perClumpMin .. perClumpMax), within this radius of its centre (metres)
	perClumpMin 3
	perClumpMax 6
	clumpRadius 0.6
	// each flower: its model's size x (scale + scaleJitter x random), leaning up to `lean` degrees
	scale 1.4
	scaleJitter 0.4
	lean 8
	seed 77
}
