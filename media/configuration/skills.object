skill jyn{
	name Jyn
	// Genki Dama blue-white (punch and kick have no kiColour: they use the robot's, from its eyes)
	kiColour 0.4 0.7 1
	// The enemy's Genki Dama: a dark, angry crimson (remove the line to give enemies the same blue-white)
	enemyKiColour 1 0.15 0.25
	// How the swarm gathers into the Genki Dama: homing (each energy ball flies straight in, one after another) or pso
	// (the 2011 Particle Swarm Optimization of the college project).
	gather homing
	// Speed of the thrown Genki Dama, units per second (2011: about 33.5; slower gives the target time to guard or dodge)
	throwSpeed 25
	damage 30
	ap 60
	energyBalls 10

	experience_multiplier 1.5
	
	one_lv_up_damage 2
	one_lv_up_ap 0
	one_lv_up_energyBalls 2
}

skill experience{
	level2 11
