import * from "robots.material"

material headUV_004/TEXFACE/headUV_004.tga : base_material{
    set $diffuseMap "headUV_004.tga"
    set $specMap "SMheadUV_004.tga"
    set $normalMap "NMheadUV_004.tga"
    set $aoMap "AOheadUV_004.png"
    set $glowMap "GMheadUV_004.tga"
    set $glowColour "1 1 1 3"

    set $diffuseCol "1 1 1 1"
    set $specularCol "1 1 1"
    set $shininess "64"
    set $metal "0.55 0.4 0.5 0"
}

material bodyUV_004/TEXFACE/bodyUV_004.tga : base_material{
    set $diffuseMap "bodyUV_004.tga"
    set $specMap "SMbodyUV_004.tga"
    set $normalMap "NMbodyUV_004.tga"
    set $aoMap "AObodyUV_004.png"

    set $diffuseCol "0.8 0.8 0.8 0.1"
    set $specularCol "0 0 0 1"
    set $shininess "64"
    set $metal "0.55 0.4 0.5 0"
}

