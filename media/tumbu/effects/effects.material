// Special-attack effect materials. Particles carry the ki colour in their colour (rgb) and a random seed (alpha),
// read by the shaders (energy.vert). Every material is fully programmable, so the shader generator leaves it alone
// (BaseApplication's ProgrammableTechniqueResolver).

// Energy orb: a dark ink ring (alpha blended) under the bright ball (additive). The ball fills orbShape.y (0.45) of
// the billboard's half size, so a billboard 2.2x the ball's diameter leaves room for the halo (SpecialInterface.h
// ORB_SCALE). Tune per attack by inheriting and setting $orbShape / $orbMotion (see energy_orb.frag).
abstract material Tumbu/EnergyOrbBase
{
    technique
    {
        pass underlay
        {
            scene_blend alpha_blend
            depth_write off
            lighting off

            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_orb_underlay_ps
            {
                param_named orbShape float4 $orbShape
                param_named orbMotion float4 $orbMotion
            }
        }
        pass glow
        {
            scene_blend add
            depth_write off
            lighting off

            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_orb_ps
            {
                param_named orbShape float4 $orbShape
                param_named orbMotion float4 $orbMotion
            }
        }
    }
}

// Punch and kick ki blasts: a tight ball, fast spin.
material Tumbu/EnergyOrb : Tumbu/EnergyOrbBase
{
    set $orbShape "0.13 0.45 0.85 1.0"
    set $orbMotion "1.4 1 0.03 0.8"
}

// Jyn (Genki Dama): a bigger white-hot core, slower heavy swirl, a stronger boil on the edge.
material Tumbu/EnergyOrb/Jyn : Tumbu/EnergyOrbBase
{
    set $orbShape "0.17 0.45 1.0 0.85"
    set $orbMotion "0.7 1.3 0.03 0.85"
}

// Ribbon trail behind a ki ball ("trail" layer of effects.object). $trailParams: band brightness, centre line
// brightness, glow, band width (see energy_trail.frag). $trailUnderlay: darkness of the band under it.
abstract material Tumbu/EnergyTrailBase
{
    technique
    {
        pass underlay
        {
            scene_blend alpha_blend
            depth_write off
            lighting off
            cull_hardware none

            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_trail_underlay_ps
            {
                param_named trailParams float4 $trailParams
                param_named trailUnderlay float4 $trailUnderlay
            }
        }
        pass glow
        {
            scene_blend add
            depth_write off
            lighting off
            cull_hardware none

            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_trail_ps
            {
                param_named trailParams float4 $trailParams
            }
        }
    }
}

material Tumbu/EnergyTrail : Tumbu/EnergyTrailBase
{
    set $trailParams "0.9 0.8 0.3 0.65"
    set $trailUnderlay "0.55 0 0 0"
}

// The swarm streaming into the Genki Dama: thin, faint streams.
material Tumbu/EnergyTrail/Mote : Tumbu/EnergyTrailBase
{
    set $trailParams "0.8 0.9 0.3 0.6"
    set $trailUnderlay "0.45 0 0 0"
}

// The thrown Genki Dama: a thick, bright wake.
material Tumbu/EnergyTrail/Jyn : Tumbu/EnergyTrailBase
{
    set $trailParams "0.75 0.7 0.35 0.7"
    set $trailUnderlay "0.6 0 0 0"
}

// Sparks shed by the balls and thrown by impacts (effects.particle).
material Tumbu/EnergySpark
{
    technique
    {
        pass
        {
            scene_blend add
            depth_write off
            lighting off
            cull_hardware none

            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_spark_ps
            {
            }
        }
    }
}

// ---- Impact pieces (energy_burst.frag). $burstParams: brightness, ring/ball size, width/core size, underlay ----

// Star-shaped hit flash (additive).
material Tumbu/Fx/Flash
{
    technique
    {
        pass
        {
            scene_blend add
            depth_write off
            lighting off
            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_burst_flash_ps
            {
                param_named burstParams float4 2.2 0.85 0.16 0
            }
        }
    }
}

// Shockwave ring: a dark band under a bright one, so it reads on the white arena floor.
material Tumbu/Fx/Ring
{
    technique
    {
        pass underlay
        {
            scene_blend alpha_blend
            depth_write off
            lighting off
            cull_hardware none
            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_burst_ring_underlay_ps
            {
                param_named burstParams float4 1.6 0.9 0.22 0.55
            }
        }
        pass glow
        {
            scene_blend add
            depth_write off
            lighting off
            cull_hardware none
            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_burst_ring_ps
            {
                param_named burstParams float4 1.6 0.9 0.22 0.55
            }
        }
    }
}

