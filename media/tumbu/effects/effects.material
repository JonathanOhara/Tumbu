// Lightning crackling on the Genki Dama ("lightning" layer): a thin, very bright core line, little glow.
material Tumbu/EnergyTrail/Lightning : Tumbu/EnergyTrailBase
{
    set $trailParams "1.2 2.2 0.25 0.6"
    set $trailUnderlay "0.35 0 0 0"
}

