            }
        }
        pass glow
        {
            scene_blend add
            depth_write off
            lighting off
            vertex_program_ref energy_vs
            {
            }
            fragment_program_ref energy_burst_dome_ps
            {
                param_named burstParams float4 1.3 0.85 0.5 0.7
            }
        }
    }
}

