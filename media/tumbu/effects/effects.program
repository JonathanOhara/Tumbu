// Special-attack effect programs (energy orbs, sparks, rings...). Unified GLSL/HLSL like the robot and shading
// programs; HLSL at shader model 4 (the default level-9 profile is too small).

vertex_program energy_vs glsl glsles hlsl
{
    source energy.vert
    target vs_4_0
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
    }
}

// Energy orb, bright pass (additive).
fragment_program energy_orb_ps glsl glsles hlsl
{
    source energy_orb.frag
    target ps_4_0
    default_params
    {
        param_named_auto time time_0_x 1000
        param_named orbShape float4 0.2 0.45 1.2 2.5
        param_named orbMotion float4 1 1 0.05 0.7
    }
}

// Energy orb, dark ring under it (alpha blended).
fragment_program energy_orb_underlay_ps glsl glsles hlsl
{
    source energy_orb.frag
    target ps_4_0
    preprocessor_defines UNDERLAY=1
    default_params
    {
        param_named_auto time time_0_x 1000
        param_named orbShape float4 0.2 0.45 1.2 2.5
        param_named orbMotion float4 1 1 0.05 0.7
    }
}

// Ribbon trail behind a ball (Tumbu/EnergyTrail*).
fragment_program energy_trail_ps glsl glsles hlsl
{
    source energy_trail.frag
    target ps_4_0
    default_params
    {
        param_named trailParams float4 1 1.6 0.4 0.75
    }
}

// Ribbon trail, dark band under it (alpha blended).
fragment_program energy_trail_underlay_ps glsl glsles hlsl
{
    source energy_trail.frag
    target ps_4_0
    preprocessor_defines UNDERLAY=1
    default_params
    {
        param_named trailParams float4 1 1.6 0.4 0.75
        param_named trailUnderlay float4 0.6 0 0 0
    }
}

// Sparks (Tumbu/EnergySpark, oriented_self billboards).
fragment_program energy_spark_ps glsl glsles hlsl
{
    source energy_spark.frag
    target ps_4_0
    default_params
    {
        param_named sparkParams float4 1.7 0.35 0 0
    }
}

fragment_program energy_burst_flash_ps glsl glsles hlsl
{
    source energy_burst.frag
    target ps_4_0
    preprocessor_defines FLASH=1
    default_params
    {
        param_named_auto time time_0_x 1000
        param_named burstParams float4 2 0.85 0.3 0.6
    }
}

fragment_program energy_burst_ring_ps glsl glsles hlsl
