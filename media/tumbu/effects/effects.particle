// Particle templates of the special-attack effects ("particles" layers of effects.object). The emitter colour is
// replaced by the effect's colour at run time; the materials brighten it (HDR) and use alpha to fade.

// Sparks shed by a flying ki ball: short streaks flung out in every direction, falling a little.
particle_system Tumbu/Fx/Sparks
{
    material Tumbu/EnergySpark
    particle_width 0.035
    particle_height 0.22
    quota 60
    billboard_type oriented_self
    cull_each false

    emitter Point
    {
        angle 180
        emission_rate 45
        velocity_min 1.2
        velocity_max 3
        time_to_live_min 0.15
        time_to_live_max 0.35
        colour 1 1 1 1
    }

    affector ColourFader
    {
        alpha -3
    }

    affector LinearForce
    {
        force_vector 0 -4 0
    }
}

// The thrown Genki Dama sheds more, longer sparks.
particle_system Tumbu/Fx/SparksBig
{
    material Tumbu/EnergySpark
    particle_width 0.05
    particle_height 0.35
    quota 120
    billboard_type oriented_self
    cull_each false

    emitter Point
    {
        angle 180
        emission_rate 80
        velocity_min 1.5
        velocity_max 4
        time_to_live_min 0.2
        time_to_live_max 0.45
        colour 1 1 1 1
    }

    affector ColourFader
    {
        alpha -2.4
    }

    affector LinearForce
    {
        force_vector 0 -3 0
    }
}

// ---- Impact pieces. A ColourFader takes alpha from 1 to 0 over the life (the shaders read it as "life left"), and
// one burst of emission (duration) per piece. ----

// Star flash at the hit point: one particle, very short, growing.
particle_system Tumbu/Fx/HitFlash
{
    material Tumbu/Fx/Flash
    particle_width 1.1
    particle_height 1.1
    quota 1
    cull_each false
    emitter Point
    {
        emission_rate 1000
        duration 0.05
        velocity 0
        time_to_live 0.16
        colour 1 1 1 1
    }
    affector ColourFader
    {
        alpha -6.25
    }
    affector Scaler
    {
        rate 4
    }
}

// Shockwave facing the camera (punch and kick hits).
particle_system Tumbu/Fx/HitRing
{
    material Tumbu/Fx/Ring
    particle_width 0.3
    particle_height 0.3
    quota 1
    cull_each false
    emitter Point
    {
        emission_rate 1000
        duration 0.05
        velocity 0
        time_to_live 0.3
        colour 1 1 1 1
    }
    affector ColourFader
    {
        alpha -3.33
    }
    affector Scaler
    {
        rate 8
    }
}

// Shockwave lying on the ground (Genki Dama impact).
particle_system Tumbu/Fx/GroundRing
{
    material Tumbu/Fx/Ring
    particle_width 0.6
    particle_height 0.6
    quota 1
    cull_each false
    billboard_type perpendicular_common
    common_direction 0 1 0
    common_up_vector 0 0 1
    emitter Point
    {
        emission_rate 1000
        duration 0.05
        velocity 0
        time_to_live 0.55
        colour 1 1 1 1
    }
    affector ColourFader
    {
        alpha -1.82
    }
    affector Scaler
    {
        rate 16
    }
}

// Spark burst flung out of a hit.
particle_system Tumbu/Fx/HitSparks
{
    material Tumbu/EnergySpark
    particle_width 0.04
    particle_height 0.3
    quota 30
    billboard_type oriented_self
    cull_each false
    emitter Point
    {
        angle 180
        emission_rate 600
