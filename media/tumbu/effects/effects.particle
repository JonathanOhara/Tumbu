// Smoke puffs rising from a big impact (grey-blue, not the ki colour).
particle_system Tumbu/Fx/Smoke
{
    material Tumbu/Fx/Smoke
    particle_width 0.6
    particle_height 0.6
    quota 8
    cull_each false
    emitter Point
    {
        angle 70
        direction 0 1 0
        emission_rate 200
        duration 0.05
        velocity_min 0.6
        velocity_max 1.6
        time_to_live_min 0.9
        time_to_live_max 1.4
        colour 0.9 0.9 0.95 1
    }
    affector ColourFader
    {
        alpha -0.8
    }
    affector Scaler
    {
        rate 1.2
    }
    affector LinearForce
    {
        force_vector 0 0.6 0
    }
}

// Ground debris thrown up by a big impact.
particle_system Tumbu/Fx/Debris
{
    material Tumbu/Fx/Debris
    particle_width 0.08
    particle_height 0.12
    quota 24
    billboard_type oriented_self
    cull_each false
    emitter Point
    {
        angle 55
        direction 0 1 0
        emission_rate 500
        duration 0.05
        velocity_min 3
        velocity_max 7
        time_to_live_min 0.6
        time_to_live_max 1
        colour 0.28 0.25 0.24 1
    }
    affector ColourFader
    {
        alpha -1
    }
    affector LinearForce
    {
        force_vector 0 -14 0
    }
}

// Muzzle flash where a punch or kick blast leaves the robot: a small, quick star.
particle_system Tumbu/Fx/MuzzleFlash
{
    material Tumbu/Fx/Flash
    particle_width 0.55
    particle_height 0.55
    quota 1
    cull_each false
    emitter Point
    {
        emission_rate 1000
        duration 0.05
        velocity 0
        time_to_live 0.12
        colour 1 1 1 1
    }
    affector ColourFader
    {
        alpha -8.3
    }
    affector Scaler
    {
        rate 3
    }
}
