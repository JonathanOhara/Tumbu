import * from "robots.material"

material headUV_002/TEXFACE/headUV_002.tga : base_material{
    set $diffuseMap "headUV_002.tga"
    set $specMap "SMheadUV_002.tga"
    set $normalMap "NMheadUV_002.tga"
    set $aoMap "AOheadUV_002.png"
    set $glowMap "GMheadUV_002.tga"
    set $glowColour "1 1 1 3"

    set $diffuseCol "1 1 1 1"
    set $specularCol "1 1 1"
    set $shininess "64"
    set $metal "0.35 0.3 0.5 0"
}

material bodyUV_002/TEXFACE/bodyUV_002.tga : base_material{
    set $diffuseMap "bodyUV_002.tga"
    set $specMap "SMbodyUV_002.tga"
    set $normalMap "NMbodyUV_002.tga"
    set $aoMap "AObodyUV_002.png"

    set $diffuseCol "0.8 0.8 0.8 0.1"
    set $specularCol "0 0 0 1"
    set $shininess "64"
    set $metal "0.35 0.3 0.5 0"
}

