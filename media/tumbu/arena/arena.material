import * from "shading.material"

// Ring posts (the 2011 texture atlas; toon shading, shading.material).
material arenaMaterial/TEXFACE/gym_arena.png : Tumbu/EnvironmentToon{
    set $diffuseMap "gym_arena.dds"
    set $aoMap "arena_ao.dds"
    set $diffuseCol "0.6 0.62 0.66 1"
}

// Ring ropes: red by day (the posts' atlas), red neon at dusk and night (Tumbu/EnvironmentNeon, keyframe neon).
material arenaRopesMaterial : Tumbu/EnvironmentNeon{
    set $diffuseMap "gym_arena.dds"
    set $aoMap "arena_ao.dds"
    set $diffuseCol "0.6 0.62 0.66 1"
}

// Ring floor and sides: grey tournament tiles in four shades (12.8 m tile, 3 cm deep joints), the charcoal T with its
// tube and the border course (ring_emblem.png). Textures from scripts/arena-textures.ps1.
material arenaFloorMaterial : Tumbu/EnvironmentStoneFloor{
    set $diffuseMap "ringtiles_col.dds"
    set $normalMap "ringtiles_nrm.dds"
    set $heightMap "ringtiles_hgt.dds"
    set $aoMap "arena_ao.dds"
    set $emblemMap "ring_emblem.dds"
    // depth 0.03 m / 12.8 m tile; no moss on the ring
    set $stoneParams "0.0023 6 30 1"
    set $mossColour "0 0 0 0"
}
