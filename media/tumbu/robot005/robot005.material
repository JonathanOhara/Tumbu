import * from "robots.material"

material headUV_005/TEXFACE/headUV_005.tga : base_material{
    set $diffuseMap "headUV_005.tga"
    set $specMap "SMheadUV_005.tga"
    set $normalMap "NMheadUV_005.tga"
    set $aoMap "AOheadUV_005.png"
    set $glowMap "GMheadUV_005.tga"
    set $glowColour "1 1 1 2.5"

    set $diffuseCol "1 1 1 1"
    set $specularCol "0 0 0 1"
    set $shininess "64"
    set $metal "0.25 0.35 0.9 0.25"
}

