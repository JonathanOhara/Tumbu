// Base material of every robot part. Each robot00N.material inherits it and sets the texture variables
// ($diffuseMap, $specMap, $normalMap, optionally $aoMap) plus colours.
material base_material{
    set $diffuseCol "1 1 1 1"
    set $specularCol "1 1 1"
    set $shininess "32"
    set $diffuseMap "white.png"
    set $specMap "white.png"
    set $normalMap "white.png"
    set $aoMap "white.png"

    // Ambient pass + one additive pass per light, with normal and specular maps (robots.program).
    technique fullShader{
        pass{
            illumination_stage ambient

            ambient 1 1 1 1
            diffuse $diffuseCol
            specular 0 0 0 0
            emissive 0 0 0 0

            vertex_program_ref ambient_vs{
            }

            fragment_program_ref ambient_ps{
            }

            texture_unit diffuseMap{
                texture $diffuseMap
            }

            texture_unit aoMap{
                texture $aoMap
            }
        }

        pass{
            illumination_stage per_light

            scene_blend add
            iteration once_per_light

            vertex_program_ref diffuse_vs{
            }

            fragment_program_ref diffuse_ps{
            }

            diffuse $diffuseCol
            specular $specularCol $shininess
            ambient 0 0 0 0

            texture_unit diffuseMap{
                texture $diffuseMap
            }

            texture_unit specMap{
                texture $specMap
            }

            texture_unit normalMap{
                texture $normalMap
            }
        }
    }

    receive_shadows on

    // Fallback without custom shaders (the shader generator lights it per vertex).
    technique simple{
        pass{
            ambient 0.5 0.5 0.5 1
            diffuse $diffuseCol
            specular $specularCol $shininess
            emissive 0 0 0 1

            texture_unit diffuseMap{
                texture $diffuseMap
                colour_op modulate
            }
        }
    }
}
