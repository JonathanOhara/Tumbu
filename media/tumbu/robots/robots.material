// Base material of every robot part. Each robot00N.material inherits it and sets the texture variables
// ($diffuseMap, $specMap, $normalMap, optionally $aoMap) plus colours and the outline.
material base_material{
    set $diffuseCol "1 1 1 1"
    set $specularCol "1 1 1"
    set $shininess "32"
    set $diffuseMap "white.png"
    set $specMap "white.png"
    set $normalMap "flat_normal.png"
    set $aoMap "white.png"
    // Emissive glow (eyes): the part texture shines where the glow map is white. $glowColour = tint + strength.
    set $glowMap "black.png"
    set $glowColour "1 1 1 0"
    // Outline width in pixels, and the colour it multiplies the part's texture by.
    set $outlineWidth "1.5"
    set $outlineColour "0.3 0.25 0.35 1"

    // Toon shading in one pass (the sun and ambient come from the shared lighting, Lighting.cpp), then the
    // outline.
    technique toon{
        pass{
            diffuse $diffuseCol
            specular $specularCol $shininess

            vertex_program_ref robot_toon_vs{
            }

            fragment_program_ref robot_toon_ps{
                param_named glowColour float4 $glowColour
            }

            texture_unit diffuseMap{
                texture $diffuseMap
            }

            texture_unit normalMap{
                texture $normalMap
            }

            texture_unit specMap{
                texture $specMap
            }

            texture_unit aoMap{
                texture $aoMap
            }

            // Depth shadow map of the sun (integrated texture shadows, Demo::createLightEffects).
            texture_unit shadowMap{
                content_type shadow
                sampler_ref Tumbu/ShadowSampler
            }

            texture_unit glowMap{
                texture $glowMap
            }
        }

        pass outline{
            diffuse $diffuseCol
            cull_hardware anticlockwise

            vertex_program_ref robot_outline_vs{
                param_named outlineWidth float $outlineWidth
            }

            fragment_program_ref robot_outline_ps{
                param_named outlineColour float4 $outlineColour
            }

            texture_unit diffuseMap{
                texture $diffuseMap
            }
        }
    }

    receive_shadows on

    // Fallback without custom shaders (the shader generator lights it per vertex).
    technique simple{
        pass{
            ambient 0.5 0.5 0.5 1
            diffuse $diffuseCol
            specular $specularCol $shininess
            emissive 0 0 0 1

            texture_unit diffuseMap{
                texture $diffuseMap
                colour_op modulate
            }
        }
    }
}
