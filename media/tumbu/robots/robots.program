// Robot lighting programs. Each shader source is written once with OgreUnifiedShader.h and compiled as HLSL on
// Direct3D 11 (shader model 4, see target; the default level-9 profile is too small for diffuse_ps) and as GLSL
// on OpenGL. Ported from the original 2011 Cg program (general.cg, see git history).

vertex_program ambient_vs glsl glsles hlsl
{
    source robot_ambient.vert
    target vs_4_0
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
    }
}

fragment_program ambient_ps glsl glsles hlsl
{
    source robot_ambient.frag
    target ps_4_0
    default_params
    {
        param_named_auto ambient ambient_light_colour
        param_named_auto matDif surface_diffuse_colour
    }
}

vertex_program diffuse_vs glsl glsles hlsl
{
    source robot_diffuse.vert
    target vs_4_0
    default_params
    {
        param_named_auto wMat world_matrix
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto spotlightDir light_direction_object_space 0
    }
}

fragment_program diffuse_ps glsl glsles hlsl
{
    source robot_diffuse.frag
    target ps_4_0
    default_params
    {
        param_named_auto lightDif0 light_diffuse_colour 0
        param_named_auto lightSpec0 light_specular_colour 0
        param_named_auto camPos camera_position
        param_named_auto matShininess surface_shininess
        param_named_auto matDif surface_diffuse_colour
        param_named_auto matSpec surface_specular_colour
        param_named_auto lightPos0 light_position 0
        param_named_auto lightAtt0 light_attenuation 0
        param_named_auto iTWMat inverse_transpose_world_matrix
        param_named_auto spotlightParams spotlight_params 0
    }
}
