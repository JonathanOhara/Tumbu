// Robot programs. Each shader source is written once with OgreUnifiedShader.h and compiled as HLSL on
// Direct3D 11 (shader model 4, see target; the default level-9 profile is too small) and as GLSL on OpenGL.
// The lighting values are the "TumbuLighting" shared parameters (Lighting.cpp, lighting.object).

vertex_program robot_toon_vs glsl glsles hlsl
{
    source robot_toon.vert
    target vs_4_0
    default_params
    {
        param_named_auto wMat world_matrix
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texViewProj texture_viewproj_matrix 0
        shared_params_ref TumbuLighting
    }
}

fragment_program robot_toon_ps glsl glsles hlsl
{
    source robot_toon.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto matDif surface_diffuse_colour
        param_named metalParams float4 0.3 0.3 0.5 0
        param_named_auto matShininess surface_shininess
        param_named_auto camPos camera_position
        param_named_auto camRight view_side_vector
        param_named_auto camUp view_up_vector
        param_named_auto camForward view_direction
        param_named_auto glowBoost custom 0
        param_named_auto glowTime time_0_2pi 2
        param_named glowColour float4 1 1 1 0
    }
}

vertex_program robot_outline_vs glsl glsles hlsl
{
    source robot_outline.vert
    target vs_4_0
    default_params
    {
        param_named_auto wMat world_matrix
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto vpMat viewproj_matrix
        param_named_auto viewportSize viewport_size
        param_named outlineWidth float 1.5
    }
}

fragment_program robot_outline_ps glsl glsles hlsl
{
    source robot_outline.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto matDif surface_diffuse_colour
        param_named outlineColour float4 0.3 0.25 0.35 1
    }
}

// Ki aura shell (Robot::updateAura, material Tumbu/KiAura): strength and colour per robot part in custom parameters.
vertex_program robot_aura_vs glsl glsles hlsl
{
    source robot_aura.vert
    target vs_4_0
    default_params
    {
        param_named_auto wMat world_matrix
        param_named_auto vpMat viewproj_matrix
        param_named_auto auraColour custom 1
        param_named_auto time time_0_x 600
        param_named_auto auraParams custom 0
    }
}

fragment_program robot_aura_ps glsl glsles hlsl
{
    source robot_aura.frag
    target ps_4_0
    default_params
    {
        param_named_auto camPos camera_position
        param_named_auto time time_0_x 600
        param_named_auto auraParams custom 0
        param_named_auto auraColour custom 1
    }
}
