import * from "robots.material"

material headUV_001/TEXFACE/headUV_001.tga : base_material{
    set $diffuseMap "headUV_001.tga"
    set $specMap "SMheadUV_001.tga"
    set $normalMap "NMheadUV_001.tga"
    set $glowMap "GMheadUV_001.tga"
    set $glowColour "1 1 1 3"
    set $aoMap "AOheadUV_001.tga"

    set $diffuseCol "1 1 1 1"
    set $specularCol "0 0 0 1"
    set $shininess "128"
}

material bodyUV_001/TEXFACE/bodyUV_001.tga : base_material{
    set $diffuseMap "bodyUV_001.tga"
    set $specMap "SMbodyUV_001.tga"
    set $normalMap "NMbodyUV_001.tga"
    // set $aoMap "AObodyUV_001.tga"

    set $diffuseCol "1 1 1 1"
    set $specularCol "0 0 0 1"
    set $shininess "128"
}


