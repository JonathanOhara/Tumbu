// Arena toon shading and post-processing programs (see robots.program for the robot ones). The shared
// parameters "TumbuLighting" are declared and filled by Lighting.cpp.

vertex_program env_toon_vs glsl glsles hlsl
{
    source env_toon.vert
    target vs_4_0
    default_params
    {
        param_named_auto wMat world_matrix
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texViewProj texture_viewproj_matrix 0
        shared_params_ref TumbuLighting
    }
}

fragment_program env_toon_ps glsl glsles hlsl
{
    source env_toon.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto matDif surface_diffuse_colour
        param_named_auto matSpec surface_specular_colour
        param_named_auto matShininess surface_shininess
        param_named_auto camPos camera_position
    }
}

vertex_program postprocess_vs glsl glsles hlsl
{
    source postprocess.vert
    target vs_4_0
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
    }
}

fragment_program postprocess_final_ps glsl glsles hlsl
{
    source postprocess_final.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto viewportSize viewport_size
        param_named flareSun float4 0 0 0 0
    }
}

// Bloom: bright pass (downsampled threshold) and a separable blur (direction set by each material).
fragment_program postprocess_bright_ps glsl glsles hlsl
{
    source postprocess_bright.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto sceneTexel inverse_texture_size 0
    }
}

fragment_program postprocess_blur_ps glsl glsles hlsl
{
    source postprocess_blur.frag
    target ps_4_0
    default_params
    {
        param_named_auto sourceTexel inverse_texture_size 0
        param_named blurDirection float4 1 0 0 0
    }
}

// God rays (Lighting.cpp sets invViewProj, shadowViewProj and camPos before the pass renders).
fragment_program postprocess_shafts_ps glsl glsles hlsl
{
    source postprocess_shafts.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto viewportSize viewport_size
    }
}

// Screen-space AO (Lighting.cpp sets invViewProj, camPos and ssaoParams before the pass renders).
fragment_program postprocess_ssao_ps glsl glsles hlsl
{
    source postprocess_ssao.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
        param_named_auto viewportSize viewport_size
    }
}

// Shadow caster for the arena (Tumbu/EnvironmentToon): depth only.
vertex_program shadow_caster_vs glsl glsles hlsl
{
    source shadow_caster.vert
    target vs_4_0
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
    }
}

fragment_program shadow_caster_ps glsl glsles hlsl
{
    source shadow_caster.frag
    target ps_4_0
}

// Depth-comparison sampler of the sun's shadow map (TumbuToon.h: tumbuShadow). Defined here because program
// scripts are parsed before the materials that use it. Outside the map (border) counts as lit.
sampler Tumbu/ShadowSampler
{
    filtering linear linear none
    tex_address_mode border
    tex_border_colour 1 1 1 1
    compare_test on
    comp_func less_equal
}

// Dust motes in the sunlight (Tumbu/Dust, dust.particle).
vertex_program dust_vs glsl glsles hlsl
{
    source dust.vert
    target vs_4_0
    default_params
    {
        param_named_auto invViewMat inverse_view_matrix
        param_named_auto time time_0_x 1000
        param_named billboardSize float 0.08
        param_named_auto camPos camera_position
        param_named_auto wMat world_matrix
        param_named_auto vpMat viewproj_matrix
        param_named_auto texViewProj texture_viewproj_matrix 0
    }
}

fragment_program dust_ps glsl glsles hlsl
{
    source dust.frag
    target ps_4_0
    default_params
    {
        shared_params_ref TumbuLighting
    }
}
