// Dust floating in the arena air: tiny motes that drift and swirl slowly and only shine in sunlight
// (Tumbu/Dust), so they sparkle inside the god rays. Created by Demo::createDust over the arena centre.
// Each mote's colour is a random seed for the shader (size, brightness, twinkle and swirl), not a colour;
// alpha fades the mote in and out.
particle_system Tumbu/ArenaDust
{
    material Tumbu/Dust
    // Base size: the shader scales each mote 0.4x..1.4x (it must know this value: dust.vert billboardSize).
    particle_width 0.08
    particle_height 0.08
    quota 1200
    billboard_type point
    cull_each false

    emitter Box
    {
        width 44
        height 9
        depth 44
        emission_rate 115
        time_to_live_min 8
        time_to_live_max 12
        direction 0 1 0
        angle 180
        velocity_min 0.06
        velocity_max 0.18
        colour_range_start 0 0 0 0
        colour_range_end 1 1 1 0
    }

    // Fade in over 2 s, out over the last 2 s (rgb, the seed, stays the same). TumbuFader, not Ogre's ColourFader2:
    // that one adds per frame to byte colours, so above ~128 fps the motes never faded in (docs/OGRE_BUGS.md, 16).
    affector TumbuFader
    {
        fade_in 2
        fade_out 2
        peak 1
    }

    // Air currents: the direction keeps changing a little (TumbuRandomiser: Ogre's DirectionRandomiser wanders less the
    // higher the frame rate).
    affector TumbuRandomiser
    {
        randomness 0.25
        scope 1
        keep_velocity true
    }
}
