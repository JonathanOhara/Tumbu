// God rays and SSAO: a separable 9-tap blur (postprocess_blur.frag), horizontal then vertical.
material Tumbu/PostProcess/BlurH{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref postprocess_vs{
            }

            fragment_program_ref postprocess_blur_ps{
                param_named blurDirection float4 1 0 0 0
            }

            texture_unit source{
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

material Tumbu/PostProcess/BlurV : Tumbu/PostProcess/BlurH{
    technique{
        pass{
            fragment_program_ref postprocess_blur_ps{
                param_named blurDirection float4 0 1 0 0
            }
        }
    }
}

// God rays (postprocess.compositor): depth of the scene and the sun's shadow map (bound by Lighting.cpp).
material Tumbu/PostProcess/LightShafts{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref postprocess_vs{
            }

            fragment_program_ref postprocess_shafts_ps{
            }

            texture_unit depth{
                tex_address_mode clamp
                filtering none
            }

            texture_unit shadowMap{
                sampler_ref Tumbu/ShadowSampler
            }
        }
    }
}

// Dust motes (dust.particle): additive, lit only where the sun's shadow map says they are in sunlight.
material Tumbu/Dust{
    technique{
        pass{
            scene_blend add
            depth_write off
            lighting off

            vertex_program_ref dust_vs{
            }

            fragment_program_ref dust_ps{
            }

            texture_unit shadowMap{
                content_type shadow
                sampler_ref Tumbu/ShadowSampler
            }
        }
    }
}

// Screen-space AO (postprocess.compositor): reads the scene depth.
material Tumbu/PostProcess/SSAO{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref postprocess_vs{
            }

            fragment_program_ref postprocess_ssao_ps{
            }

            texture_unit depth{
                tex_address_mode clamp
                filtering none
            }
        }
    }
}

// SMAA 1x anti-aliasing (Tumbu/SMAA in postprocess.compositor). Lighting.cpp makes the lookup textures and binds them
// to the "area" and "search" units (a script cannot name their RG8 / R8 formats). Filtering: SMAA reads colour, edges
// and area bilinearly (it relies on it to fetch two pixels at once), and the search texture with point sampling.
material Tumbu/SMAA/Edges{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref smaa_edges_vs{
            }

            fragment_program_ref smaa_edges_ps{
            }

            texture_unit source{
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

material Tumbu/SMAA/Weights{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref smaa_weights_vs{
            }

            fragment_program_ref smaa_weights_ps{
            }

            texture_unit edges{
                tex_address_mode clamp
                filtering linear linear none
            }

            texture_unit area{
                tex_address_mode clamp
                filtering linear linear none
            }

            texture_unit search{
                tex_address_mode clamp
                filtering none
            }
        }
    }
}

material Tumbu/SMAA/Blend{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref smaa_blend_vs{
            }

            fragment_program_ref smaa_blend_ps{
            }

            texture_unit source{
                tex_address_mode clamp
                filtering linear linear none
            }

            texture_unit weights{
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}
