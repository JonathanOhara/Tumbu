// Toon-shaded arena materials (same lighting as the robots) and the post-processing materials.

// Base of the arena and coliseum materials: set $diffuseMap and $diffuseCol.
material Tumbu/EnvironmentToon{
    set $diffuseMap "white.png"
    set $diffuseCol "1 1 1 1"
    set $specularCol "0 0 0"
    set $shininess "16"

    receive_shadows on

    technique toon{
        pass{
            diffuse $diffuseCol
            specular $specularCol $shininess

            vertex_program_ref env_toon_vs{
            }

            fragment_program_ref env_toon_ps{
            }

            texture_unit diffuseMap{
                texture $diffuseMap
            }

            // Depth shadow map of the sun (integrated texture shadows, Demo::createLightEffects).
            texture_unit shadowMap{
                content_type shadow
                sampler_ref Tumbu/ShadowSampler
            }
        }
    }

    // Fallback without custom shaders (the shader generator lights it).
    technique simple{
        pass{
            ambient 0.5 0.5 0.5 1
            diffuse $diffuseCol

            texture_unit diffuseMap{
                texture $diffuseMap
                colour_op modulate
            }
        }
    }
}

material Tumbu/PostProcess/Final{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref postprocess_vs{
            }

            fragment_program_ref postprocess_final_ps{
            }

            texture_unit scene{
                tex_address_mode clamp
                filtering none
            }

            texture_unit bloom{
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// Bloom steps (postprocess.compositor): full-screen passes on the quarter-size bloom textures.
material Tumbu/PostProcess/BrightPass{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref postprocess_vs{
            }

            fragment_program_ref postprocess_bright_ps{
            }

            texture_unit scene{
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

material Tumbu/PostProcess/BlurH{
    technique{
        pass{
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref postprocess_vs{
            }

            fragment_program_ref postprocess_blur_ps{
                param_named blurDirection float4 1 0 0 0
            }

            texture_unit source{
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

material Tumbu/PostProcess/BlurV : Tumbu/PostProcess/BlurH{
    technique{
        pass{
            fragment_program_ref postprocess_blur_ps{
                param_named blurDirection float4 0 1 0 0
            }
        }
    }
}
