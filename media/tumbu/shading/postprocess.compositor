// Post-processing of a match (Lighting.cpp adds it to the viewport): the scene is rendered into a
// half-float (HDR) texture with a readable depth buffer; god rays are marched through the sun's shadow map at
// half size and blurred; the bloom takes the bright parts down a chain of half-size steps to 1/64 and back up (a
// tight core with a wide falloff); the final pass adds both, then tone maps and grades the image onto the screen. The GUI is drawn after the
// compositor, so it is not affected.
compositor Tumbu/PostProcess
{
    technique
    {
        // scene 0 = colour, scene 1 = depth (read by the god rays)
        texture scene target_width target_height PF_FLOAT16_RGBA PF_DEPTH32F
        texture shaftsA target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_RGBA
        texture shaftsB target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_RGBA
        texture ssaoA target_width_scaled 0.5 target_height_scaled 0.5 PF_BYTE_RGBA
        texture ssaoB target_width_scaled 0.5 target_height_scaled 0.5 PF_BYTE_RGBA
        texture bloomDown1 target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_RGBA
        texture bloomDown2 target_width_scaled 0.25 target_height_scaled 0.25 PF_FLOAT16_RGBA
        texture bloomDown3 target_width_scaled 0.125 target_height_scaled 0.125 PF_FLOAT16_RGBA
        texture bloomDown4 target_width_scaled 0.0625 target_height_scaled 0.0625 PF_FLOAT16_RGBA
        texture bloomDown5 target_width_scaled 0.03125 target_height_scaled 0.03125 PF_FLOAT16_RGBA
        texture bloomDown6 target_width_scaled 0.015625 target_height_scaled 0.015625 PF_FLOAT16_RGBA
        texture bloomUp1 target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_RGBA
        texture bloomUp2 target_width_scaled 0.25 target_height_scaled 0.25 PF_FLOAT16_RGBA
        texture bloomUp3 target_width_scaled 0.125 target_height_scaled 0.125 PF_FLOAT16_RGBA
        texture bloomUp4 target_width_scaled 0.0625 target_height_scaled 0.0625 PF_FLOAT16_RGBA
        texture bloomUp5 target_width_scaled 0.03125 target_height_scaled 0.03125 PF_FLOAT16_RGBA

        target scene
        {
            input previous
        }

        // God rays: march, then one horizontal + vertical blur.
        target shaftsA
        {
            input none
            pass render_quad
            {
                // Lighting::notifyMaterialRender sets the matrices and the shadow map for this pass.
                identifier 10
                material Tumbu/PostProcess/LightShafts
                input 0 scene 1
            }
        }
        target shaftsB
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BlurH
                input 0 shaftsA
            }
        }
        target shaftsA
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BlurV
                input 0 shaftsB
            }
        }

        // Screen-space AO: depth-based occlusion, then one horizontal + vertical blur.
        target ssaoA
        {
            input none
            pass render_quad
            {
                // Lighting::notifyMaterialRender sets the matrices for this pass.
                identifier 30
                material Tumbu/PostProcess/SSAO
                input 0 scene 1
            }
        }
        target ssaoB
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BlurH
                input 0 ssaoA
            }
        }
        target ssaoA
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BlurV
                input 0 ssaoB
            }
        }

        // Bloom (mip chain): the bright parts of the scene down to half size (Karis average and threshold), five more
        // 13-tap downsamples to 1/64, then tent upsamples back to half size, each adding its level.
        target bloomDown1
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomPrefilter
                input 0 scene
            }
        }
        target bloomDown2
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomDown
                input 0 bloomDown1
            }
        }
        target bloomDown3
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomDown
                input 0 bloomDown2
            }
        }
        target bloomDown4
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomDown
                input 0 bloomDown3
            }
        }
        target bloomDown5
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomDown
                input 0 bloomDown4
            }
        }
        target bloomDown6
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomDown
                input 0 bloomDown5
            }
        }
        target bloomUp5
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomUp5
                input 0 bloomDown6
                input 1 bloomDown5
            }
        }
        target bloomUp4
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomUp4
                input 0 bloomUp5
                input 1 bloomDown4
            }
        }
        target bloomUp3
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomUp3
                input 0 bloomUp4
                input 1 bloomDown3
            }
        }
        target bloomUp2
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomUp2
                input 0 bloomUp3
                input 1 bloomDown2
            }
        }
        target bloomUp1
        {
            input none
            pass render_quad
            {
                material Tumbu/PostProcess/BloomUp1
                input 0 bloomUp2
                input 1 bloomDown1
            }
        }

        target_output
        {
            input none

            pass render_quad
            {
                // Lighting::notifyMaterialRender sets the lens flare (sun position) for this pass.
                identifier 20
                material Tumbu/PostProcess/Final
                input 0 scene
                input 1 bloomUp1
                input 2 shaftsA
                input 3 ssaoA
            }
        }
    }
}

// SMAA 1x anti-aliasing (Jimenez et al., smaa/SMAA.hlsl), chained after Tumbu/PostProcess when the option is on
// (Lighting::enablePostProcessing). Tumbu/PostProcess's final pass then renders the tone-mapped image into "colour"
// instead of the window (input previous), so SMAA works on display-space colours as it expects. Three passes: luma
// edges, blending weights (with the area and search lookup textures), neighbourhood blending onto the window. The
// GUI is drawn after the chain, so it is not affected.
compositor Tumbu/SMAA
{
    technique
    {
        texture colour target_width target_height PF_BYTE_RGBA
        texture edges target_width target_height PF_BYTE_RGBA
        texture weights target_width target_height PF_BYTE_RGBA

        target colour
        {
            input previous
        }

        // edges and weights share one depth-stencil buffer (same size, depth_pool 1): the edge pass marks its pixels in the
        // stencil, and the blending-weight pass (the expensive one) only runs on those (SMAA's own recommendation).
        target edges
        {
            input none
            // The edge pass discards the pixels without an edge, so only edge pixels get stencil 1.
            pass clear
            {
                buffers colour stencil
                colour_value 0 0 0 0
                stencil_value 0
            }
            pass stencil
            {
                check on
                comp_func always_pass
                ref_value 1
                pass_op replace
            }
            pass render_quad
            {
                material Tumbu/SMAA/Edges
                input 0 colour
            }
            pass stencil
            {
                check off
            }
        }

        target weights
        {
            input none
            // Pixels outside the stencil keep this zero weight (no blending there).
            pass clear
            {
                buffers colour
                colour_value 0 0 0 0
            }
            pass stencil
            {
                check on
                comp_func equal
                ref_value 1
                pass_op keep
            }
            pass render_quad
            {
                material Tumbu/SMAA/Weights
                input 0 edges
            }
            pass stencil
            {
                check off
            }
        }

        target_output
        {
            input none
            pass render_quad
            {
                material Tumbu/SMAA/Blend
                input 0 colour
                input 1 weights
            }
        }
    }
}
